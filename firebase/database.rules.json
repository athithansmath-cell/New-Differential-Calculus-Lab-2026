{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      ".read": true,
      "$key": {
        ".write": true,
        ".validate": "$key.matches(/^[0-9a-f]{12}$/)",
        "t": { ".validate": "newData.isNumber()" },
        "o": { ".validate": "newData.val() === 0 || newData.val() === 1" },
        "s": { "$part": { ".validate": "newData.isNumber() && $part.matches(/^[1-3]\\.[1-9]:[0-9]$/)" } },
        "w": { "$task": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000 && $task.matches(/^[1-3]\\.[1-9]$/)" } },
        "$other": { ".validate": false }
      }
    }
  }
}
